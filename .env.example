# Copy to .env.local. Every value here is server-side only (NFR-3).
# Never prefix a secret with NEXT_PUBLIC_.

# Solana devnet only (NFR-6)
SOLANA_RPC_URL=https://api.devnet.solana.com
# Public: data_deck_grants program id (Playground keypair; deploy to devnet before GRANT_BACKEND=anchor)
NEXT_PUBLIC_GRANT_PROGRAM_ID=rwoLAon5MSWyDo1wTistRj2McNJTUF1f1pwdnxzJxLP

# "anchor" once the program is deployed, "memo" for the 12:30 fallback, "mock" until then.
# Set both to the same value: the server reads GRANT_BACKEND, the browser NEXT_PUBLIC_GRANT_BACKEND.
GRANT_BACKEND=mock
NEXT_PUBLIC_GRANT_BACKEND=mock

# Public keys of the two server keypairs below (safe to expose; bounties without researcherPubkey use this one)
NEXT_PUBLIC_DEMO_RESEARCHER_PUBKEY=
NEXT_PUBLIC_RULE_DELEGATE_PUBKEY=

# Server keypairs as JSON byte arrays (devnet only)
RULE_DELEGATE_SECRET_KEY=
RESEARCHER_SECRET_KEY=

# Devnet USDC mint used for per-batch payouts
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# Claude, for /api/explain
ANTHROPIC_API_KEY=
